# Copy this file to .env and adjust. .env is gitignored — never commit real secrets.

# Postgres connection string.
# The default matches the docker-compose Postgres service.
DATABASE_URL=postgresql://postimat:postimat@localhost:5432/content_saas

# Shared bearer token the HTTP transport requires (Authorization: Bearer <token>).
# This is a DEMO stub for auth — in production use OAuth 2.1 / per-user tokens.
MCP_BEARER_TOKEN=dev-secret-token

# Where the MCP HTTP server binds.
MCP_HOST=0.0.0.0
MCP_PORT=8000
